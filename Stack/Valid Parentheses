class Solution:
    def isValid(self, s: str) -> bool:
        stack = []
        pairs = {
            ")" : "(",
            "]" : "[",
            "}" : "{"
        }
        for char in s:
            if char in "([{":
                stack.append(char)
            else:
                if not stack or pairs[char] != stack[-1]:
                    return False
                else:
                    stack.pop()
        
        return len(stack) == 0             
