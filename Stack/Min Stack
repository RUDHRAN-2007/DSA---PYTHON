class MinStack:

    def __init__(self):
        self.stack = []
        

    def push(self, value: int) -> None:
        if not self.stack:
            min_val_now = value
            self.stack.append((value,min_val_now))
        else:
            min_val_now = min(value,self.stack[-1][1])
            self.stack.append((value,min_val_now))
        

    def pop(self) -> None:
        return self.stack.pop()
        

    def top(self) -> int:
        return self.stack[-1][0]
        

    def getMin(self) -> int:
        if len(self.stack) < 2 :
            return self.stack[0][0]
        return self.stack[-1][1]
        


