class Solution:
    def removeOuterParentheses(self, s: str) -> str:

        n = len(s)
        count = 0
        result = ""
        first_element = 0

        for i in range(n):
            if(s[i] == "("):
                count += 1
            elif(s[i] == ")"):
                count -= 1

            if(count == 0):
                result += s[first_element + 1 : i]
                first_element = i+1

        return result




        
