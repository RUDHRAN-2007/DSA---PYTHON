class Solution:
    def maxDepth(self, s: str) -> int:
        n = len(s)
        count = 0
        max_par = 0

        for i in range(n):
            if(s[i] == "("):
                count += 1
            elif(s[i] == ")"):
                count -= 1

            max_par = max(count,max_par) 

        return max_par
