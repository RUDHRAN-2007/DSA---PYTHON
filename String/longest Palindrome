class Solution:
    def longestPalindrome(self, s: str) -> str:
        n = len(s)
        best = s[0]

        for i in range(n):

            left = i - 1
            right = i + 1

            while left >= 0 and right < n and s[left] == s[right]:
                left -= 1
                right += 1

            current = s[left + 1:right]

            if len(current) > len(best):
                best = current

            left = i
            right = i + 1

            while left >= 0 and right < n and s[left] == s[right]:
                left -= 1
                right += 1

            current = s[left + 1:right]

            if len(current) > len(best):
                best = current

        return best
