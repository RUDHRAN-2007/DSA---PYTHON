class Solution:
    def characterReplacement(self, s: str, k: int) -> int:
        n = len(s)
        left = 0
        right = 0
        freq = {}
        answer = 0
        while(right < n):
            if(s[right] in freq):
                freq[s[right]] += 1
            else:
                freq[s[right]] = 1

            window_len = right - left + 1
            maximum = 0
            for value,count in freq.items():
                maximum = max(maximum,count)
            
            while(window_len - maximum > k):
                freq[s[left]] -= 1
                left += 1
                window_len = right - left + 1
            answer = max(answer,window_len)
            right += 1 

        return answer


            
