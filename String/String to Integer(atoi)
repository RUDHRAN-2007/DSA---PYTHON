class Solution:
    def myAtoi(self, s: str) -> int:
        n = len(s)
        i = 0
        sign = 1
        result = 0
        
        while i < n and s[i] == ' ':
            i += 1
            
        if i < n and (s[i] == '+' or s[i] == '-'):
            if s[i] == '-':
                sign = -1
            i += 1  
        
        while i < n and s[i].isdigit():
          
            result = result * 10 + int(s[i])
            i += 1
            
      
        result = sign * result
        
        
        INT_MIN = -2147483648
        INT_MAX = 2147483647
        
        if result < INT_MIN:
            return INT_MIN
        if result > INT_MAX:
            return INT_MAX
            
        return result
