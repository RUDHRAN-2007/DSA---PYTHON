class Solution:
    def setZeroes(self, matrix: List[List[int]]) -> None:
        m = len(matrix)
        n = len(matrix[0])
        rows = [False] * m
        columns = [False] * n 
        for i in range(m):
            for j in range(n):
                if(matrix[i][j] == 0):
                    rows[i] = True
                    columns[j] = True
        
        for row in range(m):
            if rows[row] == True:
                for i in range(n):
                    matrix[row][i] = 0

        for col in range(n):
            if columns[col] == True:
                for j in range(m):
                    matrix[j][col] = 0

        return matrix

                    
                   
