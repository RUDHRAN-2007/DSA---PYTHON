class Solution:
    def productExceptSelf(self, nums: list[int]) -> list[int]:
        n = len(nums)
        answer = []
        left = 1
        right = 1
        for i in range(n):
            answer.append(left)
            left *= nums[i]
        for i in range(n-1,-1,-1):
            answer[i] *= right
            right *= nums[i]
        return answer
