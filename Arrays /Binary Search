class Solution:
    def search(self, nums: list[int], target: int) -> int:
        n = len(nums)
        left = 0
        right = n-1
        mid = right//2
        if nums[n-1] < target:
            return -1
        while left <= right:
            if nums[mid] == target :
                return mid
            elif nums[mid] > target :
                right = mid-1 
                mid = (left + right)//2
            elif nums[mid] < target:
                left = mid + 1
                mid = (left + right)//2
            
        return -1


        
        
