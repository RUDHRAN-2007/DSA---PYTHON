class Solution:
    def sortColors(self, nums: List[int]) -> None:
        n = len(nums)
        low = 0
        mid = 0
        high = n-1

        while(mid <= high):
            if(nums[mid] == 0):
                new = nums[mid]
                nums[mid] = nums[low]
                nums[low] = new
                low += 1
                mid += 1
            elif(nums[mid] == 2):
                new = nums[high]
                nums[high] = nums[mid]
                nums[mid]= new
                high -= 1
            elif(nums[mid] == 1):
                mid += 1
