class Solution:
    def generate(self, numRows: int) -> List[List[int]]:
        result = [[1]]

        for _ in range(numRows - 1):
            prev = result[-1]
            row = [1]

            for i in range(1, len(prev)):
                value = prev[i - 1] + prev[i]
                row.append(value)

            row.append(1)
            result.append(row)

        return result
