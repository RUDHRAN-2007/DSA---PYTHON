# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def removeNthFromEnd(self, head: ListNode | None, n: int) -> ListNode | None:
        prev = ListNode(0)
        prev.next = head

        slow = prev
        fast = prev
        for i in range(n):
            fast = fast.next
        
        while(fast != None and fast.next != None):
            slow = slow.next
            fast = fast.next

        slow.next = slow.next.next

        return prev.next
        
