class Solution:
    def isPalindrome(self, head: Optional[ListNode]) -> bool:
        if head is None or head.next is None:
            return True

        slow = head
        fast = head

        
        while fast is not None and fast.next is not None:
            slow = slow.next
            fast = fast.next.next

      
        prev = None
        current = slow

        while current is not None:
            temp = current.next
            current.next = prev
            prev = current
            current = temp

     
        first = head
        second = prev

        while second is not None:
            if first.val != second.val:
                return False

            first = first.next
            second = second.next

        return True
