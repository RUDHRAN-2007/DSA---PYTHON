class Solution:
    def sortList(self, head: ListNode | None) -> ListNode | None:

        if head is None or head.next is None:
            return head

        slow = head
        fast = head
        prev = None

        while fast is not None and fast.next is not None:
            prev = slow
            slow = slow.next
            fast = fast.next.next

        prev.next = None

        first_head = head
        second_head = slow

        left = self.sortList(first_head)
        right = self.sortList(second_head)

        return self.merge(left, right)

    def merge(self, left, right):

        dummy = ListNode(0)
        current = dummy

        while left and right:

            if left.val < right.val:
                current.next = left
                left = left.next
            else:
                current.next = right
                right = right.next

            current = current.next

        if left:
            current.next = left
        else:
            current.next = right

        return dummy.next
