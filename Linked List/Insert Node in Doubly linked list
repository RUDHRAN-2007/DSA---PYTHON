"""
# Definition for a Node.
class ListNode:
    def __init__(self, data, prev=None, next=None):
        self.data = data
        self.prev = prev
        self.next = next
"""

class Solution:
    def insertBeforeHead(self, head: ListNode, X: int) -> ListNode:
        new_Node = ListNode(X)
        new_Node.next = head
        head.prev = new_Node
        head = new_Node
        return head
