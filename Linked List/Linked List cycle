# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, x):
#         self.val = x
#         self.next = None

class Solution:
    def hasCycle(self, head: Optional[ListNode]) -> bool:
        visited = {}
        current = head 
        while(current != None):
            if(current in visited):
                return True
            visited[current] = 1
            current = current.next
        return False
